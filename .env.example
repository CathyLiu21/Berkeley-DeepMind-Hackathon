# Copy to .env (gitignored) and fill in. Nothing here is read automatically —
# load it with:  set -a; . ./.env; set +a
#
# GEMINI_API_KEY     used for local Gemini research + TTS calls (Cloud Run uses Vertex AI ADC).
# ANTHROPIC_API_KEY  optional; used only when a workflow selects the Claude provider.
# DEMO_PASSCODE      web tier only; empty means anyone with the URL can start runs.
# TEMPORAL_API_KEY   optional; leave empty for local or GCE self-hosted Temporal.
TEMPORAL_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEMO_PASSCODE=
